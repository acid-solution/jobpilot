# Joint deployment: copy to .env.joint; reuse existing keys when migrating data.
PUBLIC_ORIGIN=https://jobpilot.example.com
SITE_ADDRESS=jobpilot.example.com
STUDYFLOW_WEB_URL=https://studyflow.example.com
STUDYFLOW_SITE_ADDRESS=studyflow.example.com
STUDYFLOW_MCP_URL=https://studyflow.example.com/mcp
HTTP_PORT=80
HTTPS_PORT=443
COOKIE_SECURE=true
ALLOW_INSECURE_ROUTE_HTTP=false

POSTGRES_USER=jobpilot
POSTGRES_DB=jobpilot
AUTH_DB_NAME=shared_auth
POSTGRES_PASSWORD=__GENERATE__
VERIFICATION_HMAC_KEY=__GENERATE__
CREDENTIAL_ENCRYPTION_KEY=__GENERATE__
JOBPILOT_EXCHANGE_SECRET=__GENERATE__
MYSQL_DATABASE=studyflow
MYSQL_USER=studyflow
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_PASSWORD=__GENERATE__

AUTH_APP_ENV=production
EMAIL_PROVIDER=resend
DEV_OUTBOX_ENABLED=false
# Copy the existing verified mail settings; do not commit credentials.
RESEND_API_KEY=
RESEND_FROM=
JWT_KEY_ID=jobpilot-1
APP_ENV=production
WORKER_COUNT=2
LEARNING_ROUTES_ENABLED=true
AGENT_ENABLED=true

# Enable model-dependent features after providing the relevant platform keys.
PLATFORM_DEEPSEEK_API_KEY=
PLATFORM_REVIEW_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
ABILITY_REVIEW_ENABLED=false
JD_ABILITY_GRADING_ENABLED=false
JOB_CLASSIFICATION_REVIEW_ENABLED=false
ABILITY_REVIEW_USER_DAILY_LIMIT=3
ABILITY_REVIEW_GLOBAL_DAILY_LIMIT=30
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
PLATFORM_EMBEDDING_API_KEY=
GITHUB_TOKEN=
MODEL_PRICING_FILE=
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com/
SHARED_AUTH_CONTEXT=../../shared-auth
STUDYFLOW_CONTEXT=../../studyflow
