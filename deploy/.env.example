# JobPilot 部署变量。
#
# 使用步骤：
#   1. cp .env.example .env
#   2. bash generate-secrets.sh      # 生成四组随机密钥
#   3. 按下面「必改项」填好地址，再 docker compose up -d --build
#
# 这个文件里的值会通过 compose 注入容器，不会进入镜像。不要提交 .env。

# ── 必改项 ────────────────────────────────────────────────────────────────

# 浏览器实际访问的地址，必须和 SITE_ADDRESS 表达的站点一致，逐字符匹配。
# 没有域名、用 IP 直连时写成 http://<公网IP>；带非标准端口要带上端口，例如 http://47.98.1.2:8080
PUBLIC_ORIGIN=https://jobpilot.example.com

# Caddy 监听的站点地址，决定是否启用 HTTPS：
#   有域名      jobpilot.example.com     自动申请 Let's Encrypt 证书，80 自动跳 443
#   无域名      :80                      纯 HTTP，配合 IP 直连
SITE_ADDRESS=jobpilot.example.com

# 宿主机映射端口。用 IP 直连且 80 被运营商或云厂商限制时改成 8080 之类。
HTTP_PORT=80
HTTPS_PORT=443

# 有 HTTPS 时改成 true。纯 HTTP 必须是 false，否则浏览器不会保存刷新令牌 Cookie，登录无法保持。
COOKIE_SECURE=true

# ── 由 generate-secrets.sh 生成，不要手填 ─────────────────────────────────

POSTGRES_PASSWORD=__GENERATE__
VERIFICATION_HMAC_KEY=__GENERATE__
CREDENTIAL_ENCRYPTION_KEY=__GENERATE__
JOBPILOT_EXCHANGE_SECRET=__GENERATE__

# ── 数据库 ────────────────────────────────────────────────────────────────

POSTGRES_USER=jobpilot
POSTGRES_DB=jobpilot
AUTH_DB_NAME=shared_auth

# ── shared-auth ───────────────────────────────────────────────────────────
#
# 默认 production + resend：真实发送验证码，并关闭开发收件箱。
# RESEND_FROM 必须使用已验证的发件域名。缺少邮件配置时服务明确报错。
# 仅本地演示可显式改为 staging + dev + DEV_OUTBOX_ENABLED=true。
AUTH_APP_ENV=production
EMAIL_PROVIDER=resend
DEV_OUTBOX_ENABLED=false
# 必填：Resend 服务端 Key，以及已验证发件域名下的地址。
RESEND_API_KEY=
RESEND_FROM=
JWT_KEY_ID=jobpilot-1

# 后续部署 StudyFlow 时填它的公开地址，多个用逗号分隔。
STUDYFLOW_ALLOWED_ORIGINS=

# ── JobPilot 后端 ─────────────────────────────────────────────────────────

APP_ENV=production
# 每类后台任务的并发 Worker 数。2 核 4GB 用 2；配置更高可以上调。
WORKER_COUNT=2

# 平台侧 DeepSeek Key：用于岗位分类审核、能力判级等平台承担的调用。
# 用户自己的 Key 由设置页写入数据库，不在这里配置。
PLATFORM_DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PLATFORM_REVIEW_MODEL=deepseek-chat

# 百炼 Embedding。关闭时能力归一化和向量检索不可用，其余功能仍可运行。
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
PLATFORM_EMBEDDING_API_KEY=

# Agent 对话。需要数据库里已有用户自己的 DeepSeek Key 才能真正对话。
AGENT_ENABLED=true

# 可选：提高 GitHub 匿名接口的速率上限。留空也能用。
GITHUB_TOKEN=

# 三项审核/判级开关，都会消耗平台 Key 的额度。
ABILITY_REVIEW_ENABLED=false
JD_ABILITY_GRADING_ENABLED=false
JOB_CLASSIFICATION_REVIEW_ENABLED=false
ABILITY_REVIEW_USER_DAILY_LIMIT=3
ABILITY_REVIEW_GLOBAL_DAILY_LIMIT=30

# ── 学习路线（依赖 StudyFlow，先保持关闭）────────────────────────────────

LEARNING_ROUTES_ENABLED=false
STUDYFLOW_MCP_URL=
AUTH_EXCHANGE_URL=
# STUDYFLOW_MCP_URL 同时作为认证令牌受众。必须与 StudyFlow 配置的
# STUDYFLOW_MCP_RESOURCE 一致；正式部署使用 HTTPS 地址。
STUDYFLOW_WEB_URL=

# ── 可选：版本化模型单价 ──────────────────────────────────────────────────

# 留空仍然记录 token 用量，只是费用显示为未知。
MODEL_PRICING_FILE=

# ── 构建加速 ──────────────────────────────────────────────────────────────

# 阿里云 ECS 直连 proxy.golang.org 和 registry.npmjs.org 通常很慢或不可用，保持国内镜像。
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com/

# ── 共享认证服务源码位置 ──────────────────────────────────────────────────

# shared-auth 是独立仓库。默认按「三个仓库并列克隆」的相对路径查找。
# 服务器上的目录规划见 README。
SHARED_AUTH_CONTEXT=../../shared-auth
