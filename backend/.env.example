APP_ENV=development
HTTP_ADDR=127.0.0.1:18081
# 每类已启用后台任务的并发 Worker 数；正整数，修改后重启后端
WORKER_COUNT=2
DATABASE_URL=postgres://jobpilot:jobpilot@127.0.0.1:5433/jobpilot?sslmode=disable
DEV_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_MODE=shared
AUTH_JWKS_URL=http://127.0.0.1:18082/.well-known/jwks.json
AUTH_ISSUER=shared-auth
AUTH_AUDIENCE=jobpilot
CREDENTIAL_ENCRYPTION_KEY=请替换为32字节随机密钥的Base64文本
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：公共仓库检索令牌；不设置时使用 GitHub 匿名接口
GITHUB_TOKEN=
ABILITY_REVIEW_ENABLED=false
JD_ABILITY_GRADING_ENABLED=false
JOB_CLASSIFICATION_REVIEW_ENABLED=false
ABILITY_REVIEW_USER_DAILY_LIMIT=3
ABILITY_REVIEW_GLOBAL_DAILY_LIMIT=30
PLATFORM_DEEPSEEK_API_KEY=
PLATFORM_REVIEW_MODEL=deepseek-chat
EMBEDDING_ENABLED=false
AGENT_ENABLED=true
# 百炼兼容模式地址，例如 https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
PLATFORM_EMBEDDING_API_KEY=
# 学习路线先完成迁移及 StudyFlow/shared-auth 扩展，再启用。
LEARNING_ROUTES_ENABLED=false
# 三项留空可以只启用规划；导入需三项齐全。
STUDYFLOW_MCP_URL=
AUTH_EXCHANGE_URL=
JOBPILOT_EXCHANGE_SECRET=
STUDYFLOW_WEB_URL=http://127.0.0.1:5174
# 可选：版本化模型单价文件。留空仍记录 token，但费用未知；更改后重启。
MODEL_PRICING_FILE=
# 本地 Vite 开发留空；合并服务时填写构建后的 dist 目录。
FRONTEND_DIST_DIR=

# Agent 上下文预算（估算 token），修改后重启。保留原记录，不自动抽取旧聊天记忆。
AGENT_CONTEXT_ENABLED=true
AGENT_MEMORY_ENABLED=true
AGENT_CONTEXT_MODEL_WINDOW_TOKENS=65536
AGENT_CONTEXT_INPUT_MAX_TOKENS=48000
AGENT_CONTEXT_COMPACT_AT_TOKENS=32000
AGENT_CONTEXT_RECENT_TOKENS=8000
AGENT_CONTEXT_SUMMARY_MAX_TOKENS=2500
AGENT_CONTEXT_OUTPUT_RESERVE_TOKENS=4096
AGENT_CONTEXT_SAFETY_TOKENS=8192
AGENT_CONTEXT_ARTIFACT_TTL=168h
